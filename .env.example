# ========== 云 MySQL 连接配置（阿里云 RDS） ==========
# ETL 专用账号。只授予正常读写和所需存储过程权限，不授予 DROP、ALTER 或 DELETE。
DB_HOST=your-db-host.mysql.rds.aliyuncs.com
DB_PORT=3306
DB_USER=carapp_etl
DB_PASSWORD=<your-write-password>
DB_NAME=dw_auto_stock

# ========== Power BI 只读账号（仅文档占位，实际值在 02_create_powerbi_user.sql 中注入） ==========
POWERBI_READONLY_USER=powerbi_reader
POWERBI_READONLY_PASSWORD=<your-readonly-password>

# ========== 应用配置 ==========
APP_ENV=local
APP_DEBUG=true
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ========== 调度器告警（飞书/企业微信机器人 Webhook） ==========
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TYPE=feishu
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CLI_PATH=
FEISHU_ALERT_CHAT_ID=
FEISHU_BASE_TOKEN=
FEISHU_TABLE_ID=
FEISHU_TABLE_URL=
ETL_STOCK_DWD_ENABLED=false
